{
  "name": "atelier-kanban",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.mjs",
    "package:windows": "node scripts/package.mjs",
    "test:release": "node --test test/release-smoke.test.mjs",
    "test": "node --test test/*.test.mjs",
    "build:css": "sass --load-path=node_modules --style=compressed --no-source-map --quiet-deps --silence-deprecation=import styles/app.scss public/style.css",
    "watch:css": "sass --watch --load-path=node_modules --style=compressed --no-source-map --quiet-deps --silence-deprecation=import styles/app.scss public/style.css",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "bootstrap": "5.3.8",
    "sass": "1.105.2"
  }
}
